# Optional configuration: Local AI works without a .env file or API key.
# CLI default; the Streamlit provider selector takes precedence in the UI.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional OpenAI cloud configuration. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o